# Real GBC overlay PNGs vendored locally from mugwomp93/muOS_Customization for
# development/testing only - the repo declares no license and two of these
# files render Nintendo's "GAME BOY COLOR" trademark, so they must never be
# committed/published until redistribution rights are explicitly cleared.
# See the provenance/licensing note at the top of src/common/display-skins.ts.
media/borders/*.png

# Environment scene PNGs built from pret/pokecrystal source tile art
# (scripts/build-crystal-environments.py) - development/testing only. The
# repo declares no license, and these tiles are Nintendo/Game Freak's
# copyrighted pixel art in disassembled-but-unmodified form, not something
# pokecrystal's own (absent) license could re-grant. See the provenance/
# licensing note at the top of src/common/environments.ts.
media/environments/*.png

# Debug metatile atlases from build-crystal-environments.py --atlas-only -
# development visual QA only, never shipped.
/debug/

# Trainer Card "Crystal" skin decoration PNGs built from pret/pokecrystal
# source art (scripts/build-crystal-trainer-card.py) - development/testing
# only, same licensing caveat as media/environments/*.png above. See the
# provenance/licensing note at the top of that script.
media/trainer-card/*.png

