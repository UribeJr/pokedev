# Real GBC overlay PNGs vendored locally from mugwomp93/muOS_Customization.
# Kept out of git history because they're third-party binary assets copied in
# rather than originally-authored files - they ARE bundled into the packaged
# extension, with attribution given in the README's Credits section.
# See the provenance note at the top of src/common/display-skins.ts.
media/borders/*.png

# Environment scene PNGs built from pret/pokecrystal source tile art
# (scripts/build-crystal-environments.py). Kept out of git history as a
# generated build artifact rather than an originally-authored file - they ARE
# bundled into the packaged extension, with attribution given in the
# README's Credits section. See the provenance note at the top of
# src/common/environments.ts.
media/environments/*.png

# Debug metatile atlases from build-crystal-environments.py --atlas-only -
# development visual QA only, never shipped.
/debug/

# Trainer Card "Crystal" skin decoration PNGs built from pret/pokecrystal
# source art (scripts/build-crystal-trainer-card.py) - same provenance as
# media/environments/*.png above (generated build artifact, bundled into the
# packaged extension). See the provenance note at the top of that script.
media/trainer-card/*.png

